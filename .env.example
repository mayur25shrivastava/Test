# Copy to .env (docker compose reads it automatically). All of these have a free option.

# Option A (easiest): Groq. Free API key, no card: https://console.groq.com
GROQ_API_KEY=

# Option B: Google Gemini free tier: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Option C: fully local and free: install Ollama, run `ollama pull llama3.2`, then set:
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Leave LLM_PROVIDER=auto to pick whichever is configured; with none, the built-in planner is used.
# LLM_PROVIDER=auto
# LLM_MODEL=
